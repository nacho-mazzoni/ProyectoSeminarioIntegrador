{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/perfil/layout,_N_T_/perfil/direcciones/layout,_N_T_/perfil/direcciones/page,_N_T_/perfil/direcciones"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/perfil/direcciones/__PAGE__",
    "/perfil/direcciones",
    "/perfil",
    "/_index",
    "/_head"
  ]
}