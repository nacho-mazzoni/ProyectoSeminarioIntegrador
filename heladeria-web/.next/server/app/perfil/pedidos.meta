{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/perfil/layout,_N_T_/perfil/pedidos/layout,_N_T_/perfil/pedidos/page,_N_T_/perfil/pedidos"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/perfil/pedidos/__PAGE__",
    "/perfil/pedidos",
    "/perfil",
    "/_index",
    "/_head"
  ]
}