# Copiar a .env y completar antes de ejecutar: cp .env.example .env

# PostgreSQL
POSTGRES_DB=heladeria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@heladeria.com
PGADMIN_DEFAULT_PASSWORD=

# Backend - JWT
# Valor de desarrollo; regenerar antes de usar en producción:
#   openssl rand -hex 32
JWT_SECRET=7f7388e6589b2c868125acac1e6061af1fb4a0141539d8321a2af3a02b5f14af
JWT_EXPIRATION=86400000

# Backend - Mercado Pago
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
# Activar solo después de configurar el secreto de firma de la aplicación MP
MP_WEBHOOK_SIGNATURE_ENABLED=false
MP_WEBHOOK_SECRET=

# Backend - Producción (solo para el perfil "prod"; no requeridas para Docker local)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
